{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanship-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"placement": {
		"mode": "smart"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DATABASE",
			"database_name": "tanship",
			"database_id": "c5e889e3-3865-417a-a57c-8cbe35532c3c",
			"migrations_dir": "../../packages/database/drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION_KV",
			"id": "511eaf1c98e14028bc598a68fb10a3b6"
		}
	],
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "tanship"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"send_email": [
		{
			"name": "SEND_EMAIL"
		}
	],
	"vars": {
		// Production values — for local dev, override via apps/api/.dev.vars
		"APP_ENV": "production",
		"APP_NAME": "tanship",
		"BETTER_AUTH_URL": "https://api.tanship.dev",
		"CORS_ORIGIN": "https://tanship.dev",
		"VITE_URL": "https://tanship.dev",
		"SESSION_DOMAIN": "tanship.dev",
		"RESEND_FROM_EMAIL": "no-reply@mixetape.com",
		"R2_BUCKET_NAME": "tanship",
		"GITHUB_REPO_OWNER": "hanskaii",
		"GITHUB_REPO_BOILERPLATE": "tanship"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "chat-agent",
				"class_name": "ChatAgent"
			}
		]
	},
	"migrations": [
		{
			"tag": "v2",
			"new_sqlite_classes": ["ChatAgent"]
		}
	]
}
