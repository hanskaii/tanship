{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanflare-console",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"instance_type": "lite",
			"max_instances": 1
		}
	],
	"durable_objects": {
	    "bindings": [
	        {
	            "name": "Sandbox",
	            "class_name": "Sandbox",
	            "namespace_id": "dd0be404deac4defb29c28b3ba9d3aac"
	        },
	        {
	            "name": "COUNTER",
	            "class_name": "Counter",
	            "namespace_id": "9a0108f67c0247b4b664b560b21f19ba"
	        },
	        {
	            "name": "RATE_LIMITER",
	            "class_name": "RateLimiter",
	            "namespace_id": "84df1b264e304d25a5e516a85d8c4e75"
	        },
	        {
	            "name": "LOCK",
	            "class_name": "Lock",
	            "namespace_id": "1234567890abcdef1234567890abcdef"
	        }
	    ],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Sandbox"],
			"new_classes": ["Counter", "RateLimiter"]
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "tanship-index"
		}
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "7f55ef3952a844e58e747dc8585a054d"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "tanflare-storage"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tanflare-db",
			"database_id": "eb67ef9a-fb43-4e8e-8349-92c6cb82d03e"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "QUEUE",
				"queue": "tanflare-jobs"
			}
		]
	},
	"routes": [
		{
			"pattern": "x402.tanship.dev",
			"custom_domain": true
		}
	],
	"vars": {
		// Production values — for local dev, override via apps/console/.dev.vars
		"APP_ENV": "production",
		"CLOUDFLARE_ACCOUNT_ID": "526998f1dc79660b3b5d57b5fe264a16",
		// Comma-separated network slugs or CAIP-2 ids (see src/networks.ts).
		// Solana networks are only offered when SVM_PAY_TO_ADDRESS is set.
		"X402_NETWORKS": "base,base-sepolia",
		// PayAI facilitator — supports every network above (v2 exact scheme)
		"FACILITATOR_URL": "https://facilitator.payai.network"
	}
}
