{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tanflare-console",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"containers": [
		{
			"class_name": "Sandbox",
			"image": "./Dockerfile",
			"instance_type": "lite",
			"max_instances": 1
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "Sandbox",
				"class_name": "Sandbox"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Sandbox"]
		}
	],
	"vectorize": [
		{
			"binding": "VECTORIZE",
			"index_name": "tanship-index"
		}
	],
	"routes": [
		{
			"pattern": "x402.tanship.dev",
			"custom_domain": true
		}
	],
	"vars": {
		// Production values — for local dev, override via apps/console/.dev.vars
		"APP_ENV": "production",
		"CLOUDFLARE_ACCOUNT_ID": "526998f1dc79660b3b5d57b5fe264a16",
		// Comma-separated network slugs or CAIP-2 ids (see src/networks.ts).
		// Solana networks are only offered when SVM_PAY_TO_ADDRESS is set.
		"X402_NETWORKS": "base,base-sepolia",
		// PayAI facilitator — supports every network above (v2 exact scheme)
		"FACILITATOR_URL": "https://facilitator.payai.network"
	}
}
